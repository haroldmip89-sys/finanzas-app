# Names only. Copy to .env.local and fill in the values (never commit real values).
# Deployed (Vercel): variables are stored in the Vercel project panel (Settings > Environment Variables), not in files.
# Variables marked [SECRET] must never be exposed to the client or committed.

# Database (Neon Postgres)
# [SECRET]
DATABASE_URL=

# Clerk (Development instance: pk_test_ / sk_test_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [SECRET]
CLERK_SECRET_KEY=

# Clerk routes (fixed values: /sign-in, /sign-up, /)
# Value: /sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Value: /sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Value: /
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=
# Value: /
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
